+  struct hostent *h = gethostbyname(host);
+  if (!h || h->h_addrtype != AF_INET || h->h_length != 4) {
+    ws_log(a, "ERROR IPv4 DNS: %s", host);
+    return false;
+  }
+  memcpy(ip, h->h_addr_list[0], 4);
+  return !ws_cancelled(a);
+}
+static int ready(int fd, bool write) {
+  fd_set set;
+  FD_ZERO(&set);
+  FD_SET(fd, &set);
+  struct timeval t = {.tv_sec = 0, .tv_usec = 100000};
+  return lwip_select(fd + 1, write ? NULL : &set, write ? &set : NULL, NULL,
+                     &t);
+}
+static int connect_tcp(WsApp *a, struct in_addr ip, uint16_t port) {
+  int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0)
+    return -1;
+  unsigned long nb = 1;
+  if (lwip_ioctl(fd, FIONBIO, &nb) < 0) {
+    close(fd);
+    return -1;
+  }
+  struct sockaddr_in s = {
+      .sin_family = AF_INET, .sin_port = htons(port), .sin_addr = ip};
+  int r = connect(fd, (struct sockaddr *)&s, sizeof(s));
+  if (r == 0)
+    return fd;
+  if (errno != EINPROGRESS && errno != EWOULDBLOCK) {
+    close(fd);
+    return -1;
+  }
+  uint64_t end = ms() + 1800;
+  while (!ws_cancelled(a) && ms() < end) {
+    r = ready(fd, true);
+    if (r < 0)
+      break;
+    if (r > 0) {
+      int error = 0;
+      socklen_t len = sizeof(error);
+      if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &len) == 0 && !error)
+        return fd;
+      break;
+    }
+  }
+  close(fd);
+  return -1;
+}
+static void ports(WsApp *a, WsTarget *t) {
+  static const uint16_t list[] = {
+      21,  22,  23,  25,  53,   80,   110,  135,  139,  143,  443,  445,
+      465, 587, 993, 995, 1883, 3306, 3389, 5432, 6379, 8000, 8080, 8443};
+  struct in_addr ip;
+  if (!resolve(a, t->host, &ip))
+    return;
+  ws_log(a, "NMAP TCP connect: 24 common ports");
+  unsigned found = 0;
+  for (size_t i = 0; i < sizeof(list) / sizeof(list[0]) && !ws_cancelled(a);
+       i++) {
+    progress(a, "Nmap ports", i + 1, 24);
+    int fd = connect_tcp(a, ip, list[i]);
+    if (fd >= 0) {
+      found++;
+      ws_log(a, "OPEN tcp/%u", list[i]);
+      char banner[128];
+      int n = 0;
+      if (ready(fd, false) > 0)
+        n = recv(fd, banner, sizeof(banner) - 1, 0);
+      if (n > 0) {
+        banner[n] = 0;
+        ws_log(a, "BANNER %.120s", banner);
+      }
+      close(fd);
+    }
+    furi_delay_ms(15);
