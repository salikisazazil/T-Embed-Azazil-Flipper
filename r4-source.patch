+#include "webstrike_core.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+int main(void) {
+  WsTarget t;
+  char url[512];
+  assert(ws_parse("https://example.com:8443/path?q=1#part", &t));
+  assert(t.tls && t.port == 8443 && !strcmp(t.path, "/path?q=1"));
+  assert(!ws_parse("https://user:pass@example.com/", &t));
+  assert(!ws_parse("http://x:65536/", &t));
+  assert(!ws_parse("file:///etc/passwd", &t));
+  assert(!ws_parse("http://x/\r\nX: a", &t));
+  assert(!ws_parse("http://[::1]/", &t));
+  assert(ws_probe_url("https://test/a?q=old&x=2&q=again", "q", "'<>", url,
+                      sizeof(url)));
+  assert(!strcmp(url, "https://test:443/a?x=2&q=%27%3C%3E"));
+  assert(ws_probe_url("http://x/", "q", "a b", url, sizeof(url)));
+  assert(!strcmp(url, "http://x:80/?q=a%20b"));
+  assert(!ws_probe_url("http://x/", "q&x", "a", url, sizeof(url)));
+  assert(!ws_probe_url("http://x/", "q", "long", url, 10));
+  assert(ws_sql_error("You have an error in your SQL syntax"));
+  assert(!ws_sql_error("normal response"));
+  ws_clean(url, sizeof(url), "a\nb\t\033c");
+  assert(!strcmp(url, "a b  c"));
+  assert(ws_cookie_flags("a=1; Secure; HttpOnly; SameSite=Lax") == 7);
+  assert(ws_cookie_flags("secure=1; secureX; httponlyX; SameSite=invalid") ==
+         0);
+  puts("WebStrike core tests passed");
+}
