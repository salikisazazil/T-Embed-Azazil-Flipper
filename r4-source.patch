+  if (t->tls && !r->hsts)
+    ws_log(a, "REVIEW Strict-Transport-Security absent");
+  if (!r->nosniff)
+    ws_log(a, "REVIEW X-Content-Type-Options absent/invalid");
+  if (!r->frame && !ws_contains(r->body, "frame-ancestors"))
+    ws_log(a, "INFO X-Frame-Options absent; check CSP framing");
