+static const char keys[] = "abcdefghijklmnopqrstuvwxyz0123456789.-_:/"
+                           "?=&%ABCDEFGHIJKLMNOPQRSTUVWXYZ@+[]'\"<> ";
+static void input_cb(const void *event, void *ctx) {
+  WsApp *a = ctx;
+  furi_message_queue_put(a->input, event, 0);
+}
+void ws_save(WsApp *a) {
+  Storage *s = furi_record_open(RECORD_STORAGE);
+  storage_simply_mkdir(s, "/ext/apps_data");
+  storage_simply_mkdir(s, "/ext/apps_data/azazil_webstrike");
+  char path[128];
+  snprintf(path, sizeof(path),
+           "/ext/apps_data/azazil_webstrike/report-%08lx-%08lx.txt",
+           (unsigned long)a->run, (unsigned long)esp_random());
+  File *f = storage_file_alloc(s);
+  bool ok = f && storage_file_open(f, path, FSAM_WRITE, FSOM_CREATE_NEW);
+  if (ok) {
+    char header[128];
+    snprintf(header, sizeof(header),
+             "Azazil WebStrike 1.0\nIndicators are not confirmed "
+             "vulnerabilities.\nOld log lines omitted: %lu\n\n",
+             (unsigned long)a->dropped);
+    size_t n = strlen(header);
+    ok = storage_file_write(f, header, n) == n;
+    furi_mutex_acquire(a->lock, FuriWaitForever);
+    for (size_t i = 0; ok && i < a->count; i++) {
+      n = strlen(a->lines[i]);
+      ok = storage_file_write(f, a->lines[i], n) == n &&
+           storage_file_write(f, "\n", 1) == 1;
+    }
+    furi_mutex_release(a->lock);
+    storage_file_close(f);
+  }
+  if (f)
+    storage_file_free(f);
+  furi_record_close(RECORD_STORAGE);
+  ws_log(a, ok ? "SAVED %s" : "ERROR SD report write: %s", path);
+}
+static void config(WsApp *a, bool write) {
+  Storage *s = furi_record_open(RECORD_STORAGE);
+  File *f = storage_file_alloc(s);
+  if (write) {
+    storage_simply_mkdir(s, "/ext/apps_data");
+    storage_simply_mkdir(s, "/ext/apps_data/azazil_webstrike");
+  }
+  if (f && storage_file_open(f, "/ext/apps_data/azazil_webstrike/target.txt",
+                             write ? FSAM_WRITE : FSAM_READ,
+                             write ? FSOM_CREATE_ALWAYS : FSOM_OPEN_EXISTING)) {
+    if (write)
+      storage_file_write(f, a->url, strlen(a->url));
+    else {
+      size_t n = storage_file_read(f, a->url, sizeof(a->url) - 1);
+      a->url[n] = 0;
+      char *e = strchr(a->url, '\r');
+      if (!e)
+        e = strchr(a->url, '\n');
+      if (e)
+        *e = 0;
+    }
+    storage_file_close(f);
+  }
+  if (f)
+    storage_file_free(f);
+  furi_record_close(RECORD_STORAGE);
+}
+static void start(WsApp *a, int job) {
+  if (a->busy)
+    return;
+  a->job = job;
+  a->cancel = false;
+  a->done = false;
+  a->pending = false;
+  a->page = 1;
+  a->scroll = 0;
+  if (job != 9) {
+    a->run++;
+    ws_log(a, "--- session %lu ---", (unsigned long)a->run);
+  }
+  a->worker = furi_thread_alloc_ex("WebStrikeIO", 16384, ws_worker, a);
+  if (!a->worker) {
+    ws_log(a, "ERROR worker allocation");
+    return;
+  }
+  a->busy = true;
+  furi_thread_start(a->worker);
+}
+static void edit(WsApp *a, int field) {
+  a->edit_field = field;
+  a->edit_key = 0;
+  a->page = 3;
+  const char *s = field == 0   ? a->url
+                  : field == 1 ? a->param
+                  : field == 3 ? a->tx
+                               : NULL;
+  if (s)
+    snprintf(a->edit, sizeof(a->edit), "%s", s);
+  else
+    snprintf(a->edit, sizeof(a->edit), "%u", a->net_port);
+}
+static void save_edit(WsApp *a) {
+  if (a->edit_field == 0) {
+    WsTarget t;
+    if (!ws_parse(a->edit, &t)) {
+      snprintf(a->notice, sizeof(a->notice),
+               "Invalid URL: use http:// or https://");
+      return;
+    }
+    strcpy(a->url, a->edit);
+    config(a, true);
+    a->page = 0;
+  } else if (a->edit_field == 1) {
+    bool good = true;
+    for (char *p = a->edit; *p; p++)
+      if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+            (*p >= '0' && *p <= '9') || *p == '_' || *p == '-'))
+        good = false;
+    if (!good || strlen(a->edit) >= sizeof(a->param)) {
+      strcpy(a->notice, "Parameter: letters, digits, - or _");
+      return;
+    }
+    strcpy(a->param, a->edit);
+    a->page = 2;
+  } else if (a->edit_field == 2) {
+    const char *end = a->edit;
+    unsigned long n = 0;
+    while (*end >= '0' && *end <= '9' && n <= 65535)
+      n = n * 10 + (*end++ - '0');
+    if (*end || n < 1 || n > 65535) {
+      strcpy(a->notice, "Port must be 1..65535");
+      return;
+    }
+    a->net_port = n;
+    a->page = 2;
+  } else {
+    if (strlen(a->edit) >= sizeof(a->tx)) {
+      strcpy(a->notice, "Message maximum 127 characters");
+      return;
+    }
+    furi_mutex_acquire(a->lock, FuriWaitForever);
+    strcpy(a->tx, a->edit);
+    a->pending = a->busy && a->job == 7;
+    furi_mutex_release(a->lock);
+    a->page = a->busy ? 1 : 2;
+  }
+  a->notice[0] = 0;
+}
+static void handle(WsApp *a, const InputEvent *e) {
+  bool click = e->type == InputTypeShort && e->key == InputKeyOk;
+  bool hold = e->type == InputTypeLong && e->key == InputKeyOk;
+  bool turn = (e->type == InputTypePress || e->type == InputTypeRepeat) &&
+              e->key <= InputKeyLeft;
+  int d = (e->key == InputKeyUp || e->key == InputKeyRight) ? 1 : -1;
+  if (e->key == InputKeyBack &&
+      (e->type == InputTypeShort || e->type == InputTypeLong)) {
+    if (a->page == 3) {
+      if (e->type == InputTypeLong) {
+        a->page = a->busy ? 1 : (a->edit_field ? 2 : 0);
+        a->notice[0] = 0;
+      } else {
+        size_t n = strlen(a->edit);
+        if (n)
+          a->edit[n - 1] = 0;
+      }
+      return;
+    }
+    if (a->busy) {
+      furi_mutex_acquire(a->lock, FuriWaitForever);
+      a->cancel = true;
+      furi_mutex_release(a->lock);
+      strcpy(a->notice, "Cancelling; waiting for network cleanup");
+      return;
+    }
+    if (a->page)
+      a->page = 0;
+    else
+      a->exit = true;
+    return;
+  }
+  if (a->page == 3) {
+    if (turn)
+      a->edit_key = (a->edit_key + d + (int)strlen(keys)) % strlen(keys);
+    if (click) {
+      size_t n = strlen(a->edit);
+      if (n + 1 < sizeof(a->edit)) {
+        a->edit[n] = keys[a->edit_key];
+        a->edit[n + 1] = 0;
+      }
+    }
+    if (hold)
+      save_edit(a);
+    return;
+  }
+  if (a->page == 1) {
+    if (turn) {
+      a->scroll += d;
+      if (a->scroll < 0)
+        a->scroll = 0;
+    }
+    if (click && a->busy && a->job == 7)
+      edit(a, 3);
+    if (hold && !a->busy)
+      start(a, 99);
+    return;
+  }
+  if (a->page == 2) {
+    if (turn)
+      a->setting = (a->setting + d + 19) % 19;
+    if (click) {
+      if (a->setting == 0)
+        edit(a, 1);
+      else if (a->setting == 1)
+        edit(a, 2);
+      else if (a->setting == 2)
+        a->net_mode = (a->net_mode + 1) % 4;
+      else if (a->setting == 3)
+        edit(a, 3);
+      else if (a->setting != 10 && a->setting != 18)
+        a->audit_mask ^= 1 << (a->setting - 4);
+    }
+    return;
+  }
+  if (turn)
+    a->selected = (a->selected + d + WS_ITEMS) % WS_ITEMS;
+  if (hold) {
+    a->page = 2;
+    return;
+  }
+  if (click) {
+    if (a->selected == 0)
+      edit(a, 0);
+    else if (a->selected == 1)
+      start(a, 0);
+    else if (a->selected == 17) {
+      a->page = 1;
+      a->scroll = 0;
+    } else if (a->selected == 18)
+      a->page = 2;
+    else
+      start(a, a->selected - 1);
+  }
+}
+int32_t azazil_webstrike_app(void *context) {
+  UNUSED(context);
+  WsApp *a = calloc(1, sizeof(*a));
+  if (!a)
+    return -1;
+  a->lock = furi_mutex_alloc(FuriMutexTypeNormal);
+  a->input = furi_message_queue_alloc(32, sizeof(InputEvent));
+  a->pixels =
+      heap_caps_malloc(320 * 170 * 2, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+  a->stripe =
+      heap_caps_malloc(320 * 8 * 2, MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
+  if (!a->lock || !a->input || !a->pixels || !a->stripe)
+    goto cleanup;
+  a->audit_mask = 0x0f;
+  a->net_port = 80;
+  strcpy(a->param, "q");
+  strcpy(a->url, "http://192.168.1.1/");
+  config(a, false);
+  ws_log(a, "READY WebStrike 1.0 | Azazil WebStrike firmware");
+  ws_log(a, "INFO Quick Audit defaults to first four modules");
+  Gui *gui = furi_record_open(RECORD_GUI);
+  FuriPubSub *events = furi_record_open(RECORD_INPUT_EVENTS);
+  gui_direct_draw_acquire(gui);
+  FuriPubSubSubscription *sub = furi_pubsub_subscribe(events, input_cb, a);
+  while (!a->exit) {
+    InputEvent event;
+    if (furi_message_queue_get(a->input, &event, furi_ms_to_ticks(60)) ==
+        FuriStatusOk)
+      handle(a, &event);
+    if (a->busy) {
+      furi_mutex_acquire(a->lock, FuriWaitForever);
+      bool done = a->done;
+      furi_mutex_release(a->lock);
+      if (done) {
+        furi_thread_join(a->worker);
+        furi_thread_free(a->worker);
+        a->worker = NULL;
+        a->busy = false;
+        a->notice[0] = 0;
+      }
+    }
+    ws_render(a);
+  }
+  furi_pubsub_unsubscribe(events, sub);
+  gui_direct_draw_release(gui);
+  furi_record_close(RECORD_INPUT_EVENTS);
+  furi_record_close(RECORD_GUI);
+cleanup:
+  if (a->lock)
+    furi_mutex_free(a->lock);
+  if (a->input)
+    furi_message_queue_free(a->input);
+  free(a->pixels);
+  free(a->stripe);
+  free(a);
+  return 0;
+}
