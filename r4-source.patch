+unsigned ws_cookie_flags(const char *header) {
+  unsigned flags = 0;
+  const char *p = strchr(header, ';');
+  while (p) {
+    p++;
+    while (*p == ' ' || *p == '\t')
+      p++;
+    const char *end = strchr(p, ';');
+    if (!end)
+      end = p + strlen(p);
+    while (end > p && (end[-1] == ' ' || end[-1] == '\t'))
+      end--;
+    size_t n = end - p;
+    char part[128];
+    if (n < sizeof(part)) {
+      for (size_t i = 0; i < n; i++)
+        part[i] = tolower((unsigned char)p[i]);
+      part[n] = 0;
+      if (!strcmp(part, "secure"))
+        flags |= 1;
+      if (!strcmp(part, "httponly"))
+        flags |= 2;
+      if (!strcmp(part, "samesite=lax") || !strcmp(part, "samesite=strict") ||
+          !strcmp(part, "samesite=none"))
+        flags |= 4;
+    }
+    p = strchr(p, ';');
+  }
+  return flags;
+}
