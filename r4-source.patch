+static esp_err_t http_event(esp_http_client_event_t *e) {
+  Response *r = e->user_data;
+  if (ws_cancelled(r->app))
+    return ESP_FAIL;
+  if (e->event_id == HTTP_EVENT_ON_HEADER) {
+    const char *k = e->header_key;
+    const char *v = e->header_value;
+    if (!k || !v)
+      return ESP_OK;
+    size_t used = strlen(r->headers);
+    int hn = snprintf(r->headers + used, sizeof(r->headers) - used, "%s: %s\n",
+                      k, v);
+    if (hn < 0 || (size_t)hn >= sizeof(r->headers) - used)
+      r->headers_truncated = true;
+    if (!strcasecmp(k, "access-control-allow-origin"))
+      ws_clean(r->acao, sizeof(r->acao), v);
+    if (!strcasecmp(k, "access-control-allow-credentials"))
+      ws_clean(r->acac, sizeof(r->acac), v);
+    if (!strcasecmp(k, "allow"))
+      ws_clean(r->allow, sizeof(r->allow), v);
+    if (!strcasecmp(k, "set-cookie")) {
+      r->cookies++;
+      unsigned flags = ws_cookie_flags(v);
+      if (!(flags & 1))
+        r->no_secure++;
+      if (!(flags & 2))
+        r->no_httponly++;
+      if (!(flags & 4))
+        r->no_samesite++;
+    }
+    if (!strcasecmp(k, "server"))
+      ws_clean(r->server, sizeof(r->server), v);
+    if (!strcasecmp(k, "x-powered-by"))
+      ws_clean(r->powered, sizeof(r->powered), v);
+    if (!strcasecmp(k, "location"))
+      ws_clean(r->location, sizeof(r->location), v);
+    if (!strcasecmp(k, "content-type"))
+      ws_clean(r->type, sizeof(r->type), v);
+    if (!strcasecmp(k, "content-security-policy"))
+      r->csp = true;
+    if (!strcasecmp(k, "strict-transport-security"))
+      r->hsts = true;
+    if (!strcasecmp(k, "x-content-type-options") && !strcasecmp(v, "nosniff"))
+      r->nosniff = true;
+    if (!strcasecmp(k, "x-frame-options"))
+      r->frame = true;
+  }
+  return ESP_OK;
+}
+static bool http_ex(WsApp *a, const char *url, Response *r, const char *origin,
+                    bool options, const char *authorization) {
+  memset(r, 0, sizeof(*r));
+  r->app = a;
+  if (ws_cancelled(a))
+    return false;
+  esp_http_client_config_t cfg = {.url = url,
+                                  .method = options ? HTTP_METHOD_OPTIONS
+                                                    : HTTP_METHOD_GET,
+                                  .timeout_ms = 3500,
+                                  .buffer_size = 1024,
+                                  .buffer_size_tx = 1024,
+                                  .disable_auto_redirect = true,
+                                  .event_handler = http_event,
+                                  .user_data = r,
+                                  .crt_bundle_attach = esp_crt_bundle_attach,
+                                  .user_agent = "Azazil-WebStrike/1.0"};
+  esp_http_client_handle_t h = esp_http_client_init(&cfg);
+  if (!h) {
+    ws_log(a, "ERROR HTTP allocation");
+    return false;
+  }
+  bool ok = false;
+  uint64_t deadline = ms() + 12000;
+  esp_http_client_set_header(h, "Accept-Encoding", "identity");
+  if (origin)
+    esp_http_client_set_header(h, "Origin", origin);
+  if (authorization)
+    esp_http_client_set_header(h, "Authorization", authorization);
+  if (esp_http_client_open(h, 0) != ESP_OK) {
+    ws_log(a, "ERROR connect/TLS: %.120s", url);
+    goto done;
+  }
+  if (esp_http_client_fetch_headers(h) < 0) {
+    ws_log(a, "ERROR HTTP headers");
+    goto done;
+  }
+  r->status = esp_http_client_get_status_code(h);
+  while (r->length < WS_BODY && !ws_cancelled(a) && ms() < deadline) {
+    int n = esp_http_client_read(h, r->body + r->length, WS_BODY - r->length);
+    if (n < 0) {
+      ws_log(a, "ERROR HTTP read");
+      goto done;
+    }
+    if (n == 0)
+      break;
+    r->length += n;
+    furi_delay_ms(1);
+  }
+  r->body[r->length] = 0;
+  r->truncated = !esp_http_client_is_complete_data_received(h);
+  if (r->truncated)
+    ws_log(a, "LIMIT response incomplete / 16 KiB cap");
+  ok = !ws_cancelled(a) && !r->truncated;
+  if (r->status >= 300 && r->status < 400)
+    ws_log(a, "INFO redirect %d not followed: %.110s", r->status, r->location);
+done:
+  esp_http_client_close(h);
+  esp_http_client_cleanup(h);
+  furi_delay_ms(150);
+  return ok;
+}
+static bool http(WsApp *a, const char *url, Response *r) {
