+  const char *paths[] = {"/robots.txt", "/security.txt",
+                         "/.well-known/security.txt", "/.git/HEAD",
+                         "/server-status"};
+  for (size_t i = 0; i < 5 && !ws_cancelled(a); i++) {
+    snprintf(url, sizeof(url), "%s%s", t->origin, paths[i]);
