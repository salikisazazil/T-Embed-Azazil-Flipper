+static char *next_line(char **cursor) {
+  if (!**cursor)
+    return NULL;
+  char *line = *cursor;
+  char *end = strchr(line, '\n');
+  if (end) {
+    *end = 0;
+    *cursor = end + 1;
+  } else
+    *cursor = line + strlen(line);
+  size_t n = strlen(line);
+  if (n && line[n - 1] == '\r')
+    line[n - 1] = 0;
+  return line;
+}
+static void discovery(WsApp *a, WsTarget *t, Response *r, bool query) {
+  char *data =
+      load_list(query ? "values.txt" : "paths.txt",
+                query ? "test\n0\n1\ntrue\nfalse\n"
+                      : "admin/\nlogin\napi/"
+                        "\nswagger.json\nopenapi.json\nsitemap.xml\nrobots."
+                        "txt\n.well-known/security.txt\nhealth\nmetrics\n");
+  if (!data) {
+    ws_log(a, "ERROR wordlist memory");
+    return;
+  }
+  char url[WS_URL], random[48];
+  snprintf(random, sizeof(random), "__ws_missing_%08lx",
+           (unsigned long)esp_random());
+  if (query) {
+    if (!ws_probe_url(a->url, a->param, random, url, sizeof(url))) {
+      free(data);
+      ws_log(a, "ERROR query parameter");
+      return;
+    }
+  } else
+    snprintf(url, sizeof(url), "%s/%s", t->origin, random);
+  bool ok = http(a, url, r);
+  int missing = r->status;
+  size_t length = r->length;
+  char *cursor = data;
+  char *word;
+  unsigned count = 0;
+  while ((word = next_line(&cursor)) && !ws_cancelled(a) && count < 64) {
+    if (!*word || *word == '#')
+      continue;
+    if (strlen(word) > 64) {
+      ws_log(a, "SKIP word longer than 64 bytes");
+      continue;
+    }
+    bool valid = true;
+    if (query)
+      valid = ws_probe_url(a->url, a->param, word, url, sizeof(url));
+    else {
+      for (char *p = word; *p; p++)
+        if ((unsigned char)*p <= 32 || *p == ':' || *p == '\\' || *p == '?' ||
+            *p == '#' || *p == '%')
+          valid = false;
+      if (word[0] == '/' && word[1] == '/')
+        valid = false;
+      int n = snprintf(url, sizeof(url), "%s%s%s", t->origin,
+                       word[0] == '/' ? "" : "/", word);
+      if (n < 0 || n >= (int)sizeof(url))
+        valid = false;
+    }
+    if (!valid) {
+      ws_log(a, "SKIP invalid word");
+      continue;
+    }
+    count++;
+    progress(a, query ? "Query values" : "Path discovery", count, 64);
+    if (!http(a, url, r))
+      continue;
+    if (!query && r->status == 404)
+      continue;
+    if (ok && missing == r->status && length == r->length) {
+      ws_log(a, "UNCONFIRMED %s matches baseline status/length", word);
+      continue;
+    }
+    ws_log(a, "%s %s HTTP %d %u bytes", query ? "VALUE" : "PATH", word,
+           r->status, (unsigned)r->length);
+  }
+  ws_log(a, "LIMIT %u/64 words; baseline heuristic only", count);
+  free(data);
+}
+static void wordpress(WsApp *a, WsTarget *t, Response *r) {
+  if (!http(a, a->url, r))
+    return;
+  bool wp = ws_contains(r->body, "wp-content/") ||
+            ws_contains(r->body, "wp-includes/") ||
+            ws_contains(r->body, "WordPress");
+  ws_log(a, wp ? "WORDPRESS page markers found"
+               : "WORDPRESS no page markers; checks still attempted");
+  const char *prefixes[] = {"wp-content/plugins/", "wp-content/themes/"};
+  for (int i = 0; i < 2; i++) {
+    char *p = r->body;
+    unsigned count = 0;
+    while ((p = strstr(p, prefixes[i])) && count++ < 12) {
+      p += strlen(prefixes[i]);
+      char slug[65];
+      size_t n = 0;
+      while (p[n] && n < 64 &&
+             ((p[n] >= 'a' && p[n] <= 'z') || (p[n] >= 'A' && p[n] <= 'Z') ||
+              (p[n] >= '0' && p[n] <= '9') || p[n] == '-' || p[n] == '_'))
+        n++;
+      memcpy(slug, p, n);
+      slug[n] = 0;
+      if (n)
+        ws_log(a, "HINT %s %s (visible asset)", i ? "theme" : "plugin", slug);
+      if (!*p)
+        break;
+      p++;
+    }
+  }
+  const char *paths[] = {"/wp-json/", "/wp-login.php", "/readme.html"};
+  for (int i = 0; i < 3 && !ws_cancelled(a); i++) {
+    char url[WS_URL];
+    snprintf(url, sizeof(url), "%s%s", t->origin, paths[i]);
+    if (http(a, url, r))
+      ws_log(a, "WORDPRESS %s HTTP %d", paths[i], r->status);
+  }
+  ws_log(a, "LIMIT no WPScan database, CVE verdict or version proof");
+}
+static void basic_auth(WsApp *a, Response *r) {
+  if (!http(a, a->url, r) || r->status != 401 ||
+      !ws_contains(r->headers, "www-authenticate: Basic")) {
+    ws_log(a, "SKIP needs unauthenticated 401 Basic challenge");
+    return;
+  }
+  char *data = load_list("credentials.txt", NULL);
+  if (!data) {
+    ws_log(a, "ERROR credentials.txt required; max 8192 bytes");
+    return;
+  }
+  char *cursor = data;
+  char *line;
+  unsigned count = 0;
+  const char *alphabet =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  while ((line = next_line(&cursor)) && !ws_cancelled(a) && count < 20) {
+    if (!*line || *line == '#')
+      continue;
+    size_t n = strlen(line);
+    if (n > 120 || !strchr(line, ':')) {
+      ws_log(a, "SKIP credential row; require username:password <=120");
+      continue;
+    }
+    count++;
+    char auth[180] = "Basic ";
+    size_t j = 6;
+    for (size_t i = 0; i < n; i += 3) {
+      unsigned v = (unsigned char)line[i] << 16;
+      if (i + 1 < n)
+        v |= (unsigned char)line[i + 1] << 8;
+      if (i + 2 < n)
+        v |= (unsigned char)line[i + 2];
+      auth[j++] = alphabet[(v >> 18) & 63];
+      auth[j++] = alphabet[(v >> 12) & 63];
+      auth[j++] = i + 1 < n ? alphabet[(v >> 6) & 63] : '=';
+      auth[j++] = i + 2 < n ? alphabet[v & 63] : '=';
+    }
+    auth[j] = 0;
+    bool ok = http_ex(a, a->url, r, NULL, false, auth);
+    memset(auth, 0, sizeof(auth));
+    if (!ok)
+      break;
+    int status = r->status;
+    ws_log(a, "AUTH row %u HTTP %d (credentials redacted)", count, status);
+    if (status == 429 || status == 403) {
+      ws_log(a, "STOP rate-limit/access-denied response");
+      break;
+    }
+    if (status >= 200 && status < 300) {
+      if (http(a, a->url, r) && r->status == 401)
+        ws_log(a, "REVIEW row %u accepted; unauthenticated control still 401",
+               count);
+      else
+        ws_log(a, "INCONCLUSIVE control changed");
+      break;
+    }
+    for (int i = 0; i < 10 && !ws_cancelled(a); i++)
+      furi_delay_ms(100);
+  }
+  memset(data, 0, 8193);
+  free(data);
+  ws_log(a, "LIMIT HTTP Basic only; 20 paired credentials; no forms");
+}
+static void methods(WsApp *a, Response *r) {
+  if (http_ex(a, a->url, r, NULL, true, NULL)) {
+    ws_log(a, "OPTIONS HTTP %d Allow: %s", r->status,
+           *r->allow ? r->allow : "absent");
+    if (ws_contains(r->allow, "PUT") || ws_contains(r->allow, "DELETE") ||
+        ws_contains(r->allow, "TRACE"))
+      ws_log(a, "REVIEW advertised sensitive method; permission unknown");
+    ws_log(a, "INFO methods only advertised; no write methods executed");
+  }
+}
+static int tls_send(void *ctx, const unsigned char *b, size_t n) {
+  int r = send(*(int *)ctx, b, n, 0);
+  if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+    return MBEDTLS_ERR_SSL_WANT_WRITE;
+  return r < 0 ? MBEDTLS_ERR_NET_SEND_FAILED : r;
+}
+static int tls_recv(void *ctx, unsigned char *b, size_t n) {
+  int r = recv(*(int *)ctx, b, n, 0);
+  if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+    return MBEDTLS_ERR_SSL_WANT_READ;
+  return r < 0 ? MBEDTLS_ERR_NET_RECV_FAILED : r;
+}
+static void tls_attempt(WsApp *a, WsTarget *t, int version) {
+  struct in_addr ip;
+  if (!resolve(a, t->host, &ip))
+    return;
+  ws_log(a, "SSLSCAN TLS 1.%d on tcp/%u", version == 0x0303 ? 2 : 3, t->port);
+  mbedtls_ssl_context ssl;
+  mbedtls_ssl_config conf;
+  mbedtls_entropy_context entropy;
+  mbedtls_ctr_drbg_context rng;
+  mbedtls_ssl_init(&ssl);
+  mbedtls_ssl_config_init(&conf);
+  mbedtls_entropy_init(&entropy);
+  mbedtls_ctr_drbg_init(&rng);
+  int fd = -1, rc = -1;
+  if (mbedtls_ctr_drbg_seed(&rng, mbedtls_entropy_func, &entropy,
+                            (const unsigned char *)"WebStrike", 9) != 0)
+    goto done;
+  if (mbedtls_ssl_config_defaults(&conf, MBEDTLS_SSL_IS_CLIENT,
+                                  MBEDTLS_SSL_TRANSPORT_STREAM,
+                                  MBEDTLS_SSL_PRESET_DEFAULT) != 0)
+    goto done;
+  mbedtls_ssl_conf_min_tls_version(&conf, version);
+  mbedtls_ssl_conf_max_tls_version(&conf, version);
+  mbedtls_ssl_conf_rng(&conf, mbedtls_ctr_drbg_random, &rng);
+  mbedtls_ssl_conf_authmode(&conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+  if (esp_crt_bundle_attach(&conf) != ESP_OK)
+    goto done;
+  if (mbedtls_ssl_setup(&ssl, &conf) != 0 ||
+      mbedtls_ssl_set_hostname(&ssl, t->host) != 0)
+    goto done;
+  fd = connect_tcp(a, ip, t->port);
+  if (fd < 0)
+    goto done;
+  mbedtls_ssl_set_bio(&ssl, &fd, tls_send, tls_recv, NULL);
+  uint64_t end = ms() + 12000;
+  do {
+    rc = mbedtls_ssl_handshake(&ssl);
+    if (rc == 0)
+      break;
+    if (rc != MBEDTLS_ERR_SSL_WANT_READ && rc != MBEDTLS_ERR_SSL_WANT_WRITE)
+      break;
+    furi_delay_ms(20);
+  } while (!ws_cancelled(a) && ms() < end);
+  if (rc == 0) {
+    ws_log(a, "TLS negotiated: %s", mbedtls_ssl_get_version(&ssl));
+    ws_log(a, "CIPHER %s", mbedtls_ssl_get_ciphersuite(&ssl));
+    ws_log(a, "CERT verified hostname + CA bundle");
+    ws_log(a, "CERT verification flags: %08lx",
+           (unsigned long)mbedtls_ssl_get_verify_result(&ssl));
+    const mbedtls_x509_crt *cert = mbedtls_ssl_get_peer_cert(&ssl);
+    if (cert) {
+      char info[1200];
+      int n = mbedtls_x509_crt_info(info, sizeof(info), "", cert);
+      if (n > 0) {
+        char *p = info;
+        while (*p) {
+          char *e = strchr(p, '\n');
+          if (e)
+            *e = 0;
+          ws_log(a, "CERT %.170s", p);
+          if (!e)
+            break;
+          p = e + 1;
+        }
+      }
+    }
+  }
+done:
+  if (rc != 0)
+    ws_log(a, "INCONCLUSIVE TLS failed -0x%04x; clock/CA/network?",
+           (unsigned)-rc);
+  if (fd >= 0)
+    close(fd);
+  mbedtls_ssl_free(&ssl);
+  mbedtls_ssl_config_free(&conf);
+  mbedtls_ctr_drbg_free(&rng);
+  mbedtls_entropy_free(&entropy);
+}
+static void tls_scan(WsApp *a, WsTarget *t) {
+  WsTarget tls_target = *t;
+  if (!t->tls && t->port == 80)
+    tls_target.port = 443;
+  t = &tls_target;
+#ifdef MBEDTLS_SSL_PROTO_TLS1_2
+  tls_attempt(a, t, 0x0303);
+#endif
+#ifdef MBEDTLS_SSL_PROTO_TLS1_3
+  if (!ws_cancelled(a))
+    tls_attempt(a, t, 0x0304);
+#else
+  ws_log(a, "LIMIT TLS 1.3 not compiled into this firmware");
+#endif
+  ws_log(a, "LIMIT legacy TLS and cipher enumeration not tested");
+}
+static void input_probe(WsApp *a, bool sql, Response *base) {
+  if (!*a->param) {
+    ws_log(a, "SKIP set query parameter in Settings");
+    return;
+  }
+  Response *r = calloc(1, sizeof(*r));
+  if (!r) {
+    ws_log(a, "ERROR probe memory");
+    return;
+  }
+  char url[WS_URL], marker[64];
+  snprintf(marker, sizeof(marker), "ws%08lx", (unsigned long)esp_random());
+  if (sql) {
+    ws_log(a, "SQLMAP indicator check; no exploitation");
+    const char *before = ws_sql_error(base->body);
+    const char *probes[] = {"'", "\""};
+    for (size_t i = 0; i < 2 && !ws_cancelled(a); i++) {
+      if (!ws_probe_url(a->url, a->param, probes[i], url, sizeof(url)))
+        break;
+      if (!http(a, url, r))
+        continue;
+      ws_log(a, "EVIDENCE query=%s probe=%u HTTP=%d", a->param, (unsigned)i + 1,
+             r->status);
+      const char *e = ws_sql_error(r->body);
+      if (e && !before)
+        ws_log(a, "REVIEW new SQL error marker: %s", e);
+      else
+        ws_log(a, "INFO probe %u: no new known SQL error", (unsigned)i + 1);
+    }
+    ws_log(a, "LIMIT no SQLi confirmation or blind/time probes");
+  } else {
+    char payload[96];
+    snprintf(payload, sizeof(payload), "%s<>\"'&", marker);
+    if (ws_probe_url(a->url, a->param, payload, url, sizeof(url)) &&
+        http(a, url, r)) {
+      ws_log(a, "EVIDENCE query=%s marker=%s", a->param, marker);
+      ws_log(a, "CONTENT-TYPE %s", r->type);
+      if (strstr(r->body, payload))
+        ws_log(a, "REVIEW raw reflected marker + delimiters");
+      else if (strstr(r->body, marker))
+        ws_log(a, "INFO marker reflected; inspect output encoding");
+      else
+        ws_log(a, "INFO marker not found in response sample");
+      ws_log(a, "LIMIT reflection is not confirmed executable XSS");
+    }
+  }
+  free(r);
+}
+static void netcat(WsApp *a, WsTarget *t) {
+  bool udp = a->net_mode & 1, listen_mode = a->net_mode >= 2;
+  int fd = -1, client = -1;
+  struct sockaddr_in peer = {.sin_family = AF_INET,
+                             .sin_port = htons(a->net_port)};
+  socklen_t peerlen = sizeof(peer);
+  bool have_peer = !listen_mode;
+  unsigned long nb = 1;
+  if (!listen_mode && !resolve(a, t->host, &peer.sin_addr))
+    return;
+  if (!listen_mode && !udp)
+    fd = connect_tcp(a, peer.sin_addr, a->net_port);
+  else {
+    fd = socket(AF_INET, udp ? SOCK_DGRAM : SOCK_STREAM, 0);
+    if (fd >= 0) {
+      lwip_ioctl(fd, FIONBIO, &nb);
+      if (listen_mode) {
+        struct sockaddr_in local = {.sin_family = AF_INET,
+                                    .sin_port = htons(a->net_port),
+                                    .sin_addr.s_addr = INADDR_ANY};
+        if (bind(fd, (struct sockaddr *)&local, sizeof(local)) < 0 ||
+            (!udp && listen(fd, 1) < 0)) {
+          close(fd);
+          fd = -1;
+        }
+      }
+    }
+  }
+  if (fd < 0) {
+    ws_log(a, "ERROR socket/connect/bind");
+    return;
+  }
+  ws_log(a, "NETCAT %s %s port %u", udp ? "UDP" : "TCP",
+         listen_mode ? "listener" : "client", a->net_port);
+  ws_log(a, "INFO 120s session; OK compose/send; Back cancel");
+  int io = fd;
+  uint64_t end = ms() + 120000;
+  if (listen_mode && !udp) {
+    ws_log(a, "INFO waiting for one client");
+    while (!ws_cancelled(a) && ms() < end) {
+      client = accept(fd, (struct sockaddr *)&peer, &peerlen);
+      if (client >= 0) {
+        lwip_ioctl(client, FIONBIO, &nb);
+        io = client;
+        have_peer = true;
+        break;
+      }
+      furi_delay_ms(50);
+    }
+    if (client < 0)
+      goto done;
+    ws_log(a, "INFO client accepted");
+  }
+  while (!ws_cancelled(a) && ms() < end) {
+    char b[256];
+    int n = udp ? recvfrom(io, b, sizeof(b) - 1, 0, (struct sockaddr *)&peer,
+                           &peerlen)
+                : recv(io, b, sizeof(b) - 1, 0);
+    if (n > 0) {
+      b[n] = 0;
+      have_peer = true;
+      ws_log(a, "RX %u bytes: %.150s", n, b);
+    } else if (n == 0 && !udp) {
+      ws_log(a, "INFO peer closed");
+      break;
+    } else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+      ws_log(a, "ERROR socket receive");
+      break;
+    }
+    char tx[128];
+    bool pending = false;
+    furi_mutex_acquire(a->lock, FuriWaitForever);
+    if (a->pending && have_peer) {
+      strcpy(tx, a->tx);
+      a->pending = false;
+      pending = true;
+    }
+    furi_mutex_release(a->lock);
+    if (pending) {
+      size_t len = strlen(tx), off = 0;
+      uint64_t send_end = ms() + 3000;
+      while (off < len && !ws_cancelled(a) && ms() < send_end) {
+        int sent = udp ? sendto(io, tx + off, len - off, 0,
+                                (struct sockaddr *)&peer, peerlen)
+                       : send(io, tx + off, len - off, 0);
+        if (sent > 0)
+          off += sent;
+        else if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+          furi_delay_ms(20);
+          continue;
+        } else
+          break;
+        if (udp)
+          break;
+      }
+      ws_log(a, "TX %u/%u bytes", (unsigned)off, (unsigned)len);
+    }
+    furi_delay_ms(30);
+  }
+done:
+  if (client >= 0)
+    close(client);
+  close(fd);
+  ws_log(a, "INFO socket closed");
+}
+int32_t ws_worker(void *context) {
+  WsApp *a = context;
+  WsTarget t;
+  if (a->job == 99) {
+    ws_save(a);
+    goto done;
+  }
+  if (!wlan_hal_is_connected()) {
+    ws_log(a, "ERROR connect Wi-Fi in firmware settings first");
+    goto done;
+  }
+  if (!ws_parse(a->url, &t)) {
+    ws_log(a, "ERROR use http(s) URL; IPv4/DNS only");
+    goto done;
+  }
+  ws_log(a, "TARGET %s", a->url);
+  ws_log(a, "RUN %lu | indicators require manual review",
+         (unsigned long)a->run);
+  if (a->job == 7) {
+    progress(a, "Netcat session", 1, 1);
+    netcat(a, &t);
+    goto done;
+  }
+  for (int module = 1; module <= WS_MODULES && !ws_cancelled(a); module++) {
+    if (module == 7 || (module == 15 && a->job == 0))
+      continue;
+    if (a->job != 0 && a->job != module)
+      continue;
+    if (a->job == 0 && !(a->audit_mask & (1 << (module - 1))))
+      continue;
+    progress(a, ws_names[module + 1], 1, 1);
+    if (module == 12) {
+      struct in_addr ip;
+      if (resolve(a, t.host, &ip)) {
+        const unsigned char *b = (const unsigned char *)&ip;
+        ws_log(a, "DNS %s -> %u.%u.%u.%u", t.host, b[0], b[1], b[2], b[3]);
+        ws_log(a, "LIMIT first IPv4 address via configured resolver");
+      }
+      continue;
+    }
+    if (module == 1) {
+      ports(a, &t);
+      continue;
+    }
+    if (module == 4) {
+      tls_scan(a, &t);
+      continue;
+    }
+    Response *r = calloc(1, sizeof(*r));
+    if (!r) {
+      ws_log(a, "ERROR HTTP memory");
+      break;
+    }
+    if (module == 13) {
+      wordpress(a, &t, r);
+      free(r);
+      continue;
+    }
+    if (module == 14) {
+      discovery(a, &t, r, true);
+      free(r);
+      continue;
+    }
+    if (module == 15) {
+      basic_auth(a, r);
+      free(r);
+      continue;
+    }
+    if (module == 9) {
+      cors(a, r);
+      free(r);
+      continue;
+    }
+    if (module == 10) {
+      discovery(a, &t, r, false);
+      free(r);
+      continue;
+    }
+    if (module == 11) {
+      methods(a, r);
+      free(r);
+      continue;
+    }
+    bool complete = http(a, a->url, r);
+    if (r->status && module == 2)
+      whatweb(a, r);
+    else if (r->status && module == 8)
+      headers(a, r);
+    else if (r->status >= 200 && r->status < 300 && module == 3)
+      nikto(a, &t, r);
+    else if (complete && r->status >= 200 && r->status < 300) {
+      if (module == 8)
+        headers(a, r);
+      if (module == 3)
+        nikto(a, &t, r);
+      if (module == 5 || module == 6)
+        input_probe(a, module == 6, r);
+    } else
+      ws_log(a, "INCONCLUSIVE HTTP %d; module %d skipped", r->status, module);
+    free(r);
+  }
+  ws_log(a, ws_cancelled(a) ? "CANCELLED; partial results retained"
+                            : "DONE selected checks finished");
+  if (a->job == 0)
+    ws_save(a);
+done:
+  furi_mutex_acquire(a->lock, FuriWaitForever);
+  a->done = true;
+  furi_mutex_release(a->lock);
+  return 0;
+}
