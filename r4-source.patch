+bool ws_contains(const char *h, const char *n) {
+  if (!h || !n)
+    return false;
+  for (; *h; h++) {
+    size_t i = 0;
+    while (n[i] && h[i] &&
+           tolower((unsigned char)h[i]) == tolower((unsigned char)n[i]))
+      i++;
+    if (!n[i])
+      return true;
+  }
+  return false;
+}
+void ws_clean(char *out, size_t cap, const char *in) {
+  if (!cap)
+    return;
+  size_t n = 0;
+  while (in && *in && n + 1 < cap) {
+    unsigned char c = *in++;
+    out[n++] = (c >= 32 && c < 127) ? c : ' ';
+  }
+  out[n] = 0;
+}
+bool ws_parse(const char *url, WsTarget *t) {
+  memset(t, 0, sizeof(*t));
+  if (!url || strlen(url) >= WS_URL)
+    return false;
+  const char *p;
+  if (!strncmp(url, "https://", 8)) {
+    t->tls = true;
+    t->port = 443;
+    p = url + 8;
+  } else if (!strncmp(url, "http://", 7)) {
+    t->port = 80;
+    p = url + 7;
+  } else
+    return false;
+  const char *host = p;
+  while (*p && *p != '/' && *p != '?' && *p != ':' && *p != '#')
+    p++;
+  size_t len = p - host;
+  if (!len || len >= sizeof(t->host))
+    return false;
+  for (size_t i = 0; i < len; i++)
+    if (!isalnum((unsigned char)host[i]) && host[i] != '.' && host[i] != '-')
+      return false;
+  memcpy(t->host, host, len);
+  if (*p == ':') {
+    p++;
+    unsigned long port = 0;
+    const char *start = p;
+    while (isdigit((unsigned char)*p)) {
+      port = port * 10 + (*p++ - '0');
+      if (port > 65535)
+        return false;
+    }
+    if (p == start || !port)
+      return false;
+    t->port = port;
+  }
+  if (*p && *p != '/' && *p != '?' && *p != '#')
+    return false;
+  for (const char *c = p; *c; c++)
+    if ((unsigned char)*c <= 32 || (unsigned char)*c >= 127)
+      return false;
+  const char *end = strchr(p, '#');
+  len = end ? (size_t)(end - p) : strlen(p);
+  size_t prefix = (*p != '/' ? 1 : 0);
+  if (len + prefix >= sizeof(t->path))
+    return false;
+  if (prefix)
+    t->path[0] = '/';
+  memcpy(t->path + prefix, p, len);
+  t->path[len + prefix] = 0;
+  int n = snprintf(t->origin, sizeof(t->origin), "%s://%s:%u",
+                   t->tls ? "https" : "http", t->host, t->port);
+  return n > 0 && (size_t)n < sizeof(t->origin);
+}
+static bool encode(const char *in, char *out, size_t cap) {
+  const char *hex = "0123456789ABCDEF";
+  size_t j = 0;
+  for (; *in; in++) {
+    unsigned char c = *in;
+    bool plain = isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~';
+    size_t n = plain ? 1 : 3;
+    if (j + n >= cap)
+      return false;
+    if (plain)
+      out[j++] = c;
+    else {
+      out[j++] = '%';
+      out[j++] = hex[c >> 4];
+      out[j++] = hex[c & 15];
+    }
+  }
+  out[j] = 0;
+  return true;
+}
+bool ws_probe_url(const char *url, const char *parameter, const char *value,
+                  char *out, size_t cap) {
+  WsTarget t;
+  if (!ws_parse(url, &t) || !parameter || !*parameter)
+    return false;
+  for (const char *p = parameter; *p; p++)
+    if (!isalnum((unsigned char)*p) && *p != '_' && *p != '-')
+      return false;
+  char enc[192];
+  if (!encode(value, enc, sizeof(enc)))
+    return false;
+  /* Replace one existing parameter; never append a duplicate selected key. */
+  char *query = strchr(t.path, '?');
+  char path[384];
+  size_t used = 0;
+  if (query) {
+    size_t base = query - t.path;
+    memcpy(path, t.path, base);
+    used = base;
+    path[used] = 0;
+    const char *q = query + 1;
+    bool first = true;
+    while (*q) {
+      const char *end = strchr(q, '&');
+      if (!end)
+        end = q + strlen(q);
+      const char *eq = memchr(q, '=', end - q);
+      size_t keylen = eq ? (size_t)(eq - q) : (size_t)(end - q);
+      if (!(keylen == strlen(parameter) && !strncmp(q, parameter, keylen))) {
+        size_t n = end - q;
+        if (used + 1 + n >= sizeof(path))
+          return false;
+        path[used++] = first ? '?' : '&';
+        memcpy(path + used, q, n);
+        used += n;
+        path[used] = 0;
+        first = false;
+      }
+      q = *end ? end + 1 : end;
+    }
+  } else {
+    strcpy(path, t.path);
+    used = strlen(path);
+  }
+  int n = snprintf(out, cap, "%s%s%c%s=%s", t.origin, path,
+                   strchr(path, '?') ? '&' : '?', parameter, enc);
+  return n > 0 && (size_t)n < cap;
+}
+const char *ws_sql_error(const char *body) {
+  static const char *patterns[] = {"you have an error in your sql syntax",
+                                   "sqlite_error",
+                                   "unclosed quotation mark",
+                                   "pg_query():",
+                                   "ora-01756",
+                                   "quoted string not properly terminated",
+                                   "mysql_fetch",
+                                   "postgresql query failed"};
+  for (size_t i = 0; i < sizeof(patterns) / sizeof(patterns[0]); i++)
+    if (ws_contains(body, patterns[i]))
+      return patterns[i];
+  return NULL;
+}
