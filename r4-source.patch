+static char *load_list(const char *name, const char *fallback) {
+  char *data = calloc(1, 8193);
+  if (!data)
+    return NULL;
+  Storage *s = furi_record_open(RECORD_STORAGE);
+  File *f = storage_file_alloc(s);
+  char path[128];
+  snprintf(path, sizeof(path), "/ext/apps_data/azazil_webstrike/%s", name);
+  bool ok = false;
+  if (f && storage_file_open(f, path, FSAM_READ, FSOM_OPEN_EXISTING)) {
+    uint64_t n = storage_file_size(f);
+    if (n <= 8192)
+      ok = storage_file_read(f, data, n) == n;
+    storage_file_close(f);
+  }
+  if (f)
+    storage_file_free(f);
+  furi_record_close(RECORD_STORAGE);
+  if (!ok) {
+    if (fallback)
+      strcpy(data, fallback);
+    else {
+      free(data);
+      return NULL;
+    }
+  }
+  return data;
